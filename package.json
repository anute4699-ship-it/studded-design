{
  "name": "studded-design-site",
  "version": "1.0.0",
  "private": true,
  "description": "Studded Design: studded model briefs and Venture Scout, hosted on Netlify",
  "type": "module",
  "scripts": {
    "check": "esbuild netlify/functions/api.mts netlify/functions/ai.mts --bundle --platform=node --format=esm --outdir=.check --log-level=warning && esbuild netlify/edge-functions/gate.ts --bundle --format=esm --outdir=.check/edge --log-level=warning"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^2.11.0",
    "@netlify/functions": "^3.0.0",
    "esbuild": "^0.24.0"
  }
}
